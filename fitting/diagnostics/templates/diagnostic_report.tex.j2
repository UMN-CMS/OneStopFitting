\definecolor{okgreen}{HTML}{2ECC40}
\definecolor{consyellow}{HTML}{FFDC00}
\definecolor{dangred}{HTML}{FF4136}

\newcommand{\verdictbadge}[1]{%
  \ifnum\pdfstrcmp{#1}{OK}=0
    \textcolor{okgreen}{\textbf{OK}}%
  \else\ifnum\pdfstrcmp{#1}{CONSERVATIVE}=0
    \textcolor{consyellow}{\textbf{CONS}}%
  \else\ifnum\pdfstrcmp{#1}{DANGEROUS}=0
    \textcolor{dangred}{\textbf{DANG}}%
  \else
    #1%
  \fi\fi\fi
}

