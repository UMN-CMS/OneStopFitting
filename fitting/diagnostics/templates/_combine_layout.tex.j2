%% ============================================================
%%  Limits + Significance + Fit Results
%% ============================================================
[- set limits = combine.get("limits", {}) -]
[- set cex = combine_extra if combine_extra is defined else {} -]
\begin{tabularx}{\textwidth}{@{\hspace{2pt}} L @{\hspace{4pt}} L @{\hspace{4pt}} L @{\hspace{2pt}}}

  %% Limits table
  \begin{minipage}[t]{\linewidth}
    \small\textbf{Exclusion Limits}\\[0.3em]
    \begin{tabular}{@{} l r @{}}
      \toprule
      Quantity & Value \\
      \midrule
      Observed & [[ "%.4g" | format(limits.get("observed", 0)) ]] \\
      Expected & [[ "%.4g" | format(limits.get("expected", 0)) ]] \\
      $-1\sigma$ & [[ "%.4g" | format(limits.get("expected_minus_1sigma", 0)) ]] \\
      $+1\sigma$ & [[ "%.4g" | format(limits.get("expected_plus_1sigma", 0)) ]] \\
      $-2\sigma$ & [[ "%.4g" | format(limits.get("expected_minus_2sigma", 0)) ]] \\
      $+2\sigma$ & [[ "%.4g" | format(limits.get("expected_plus_2sigma", 0)) ]] \\
      \bottomrule
    \end{tabular}
  \end{minipage} &

  %% Significance & GOF table
  \begin{minipage}[t]{\linewidth}
    \small\textbf{Significance \& GOF}\\[0.3em]
    \begin{tabular}{@{} l r @{}}
      \toprule
      Quantity & Value \\
      \midrule
      Significance & [[ "%.4g" | format(combine.get("significance", 0)) ]] \\
      GOF $p$-value & [[ "%.4g" | format(combine.get("gof_p_value", 0)) ]] \\
      GOF Test Stat & [[ "%.4g" | format(combine.get("gof_test_statistic", 0)) ]] \\
      [- if cex.get("expected_sensitivity") is not none -]
      $1/r_{\mathrm{exp}}$ & [[ "%.3g" | format(cex["expected_sensitivity"]) ]] \\
      [- endif -]
      \bottomrule
    \end{tabular}
  \end{minipage} &

  %% Fit results table
  \begin{minipage}[t]{\linewidth}
    \small\textbf{Fit Results}\\[0.3em]
    \begin{tabular}{@{} l r @{}}
      \toprule
      Quantity & Value \\
      \midrule
      [- if cex.get("fitted_signal_strength") is not none -]
      $r$ (S+B fit) & [[ "%.3g" | format(cex["fitted_signal_strength"]) ]] $\pm$ [[ "%.3g" | format(cex.get("fitted_signal_strength_err", 0)) ]] \\
      [- endif -]
      [- if cex.get("bonly_signal_strength") is not none -]
      $r$ (B-only) & [[ "%.3g" | format(cex["bonly_signal_strength"]) ]] \\
      [- endif -]
      [- if cex.get("multidim_r") is not none -]
      [- set mdf_err = cex.get("multidim_r_err", [0,0]) -]
      $r$ (MultiDim) & [[ "%.3g" | format(cex["multidim_r"]) ]] ${}^{+[[ "%.2g" | format(mdf_err[0]) ]]}_{-[[ "%.2g" | format(mdf_err[1]) ]]}$ \\
      [- endif -]
      [- if cex.get("likelihood_scan_best_r") is not none -]
      $r$ (NLL scan) & [[ "%.3g" | format(cex["likelihood_scan_best_r"]) ]] \\
      [- endif -]
      \bottomrule
    \end{tabular}
  \end{minipage} \\
\end{tabularx}

