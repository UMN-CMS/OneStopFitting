[- set summary_path = image_paths["summary"] -]
[- set ppc_path = image_paths["ppc"] -]
[- set pulls_path = image_paths["pulls"] -]
[- set chi2_path = image_paths.get("chi2") -]
[- set mp_width = "\\linewidth" if chi2_path else "0.33\\linewidth" -]

\begin{tabularx}{\textwidth}{@{}L L@{}}
\includegraphics[width=\linewidth]{[[ summary_path ]]} &
\includegraphics[width=\linewidth]{[[ ppc_path ]]} \\
\end{tabularx}

\vspace{0.4em}

[- if chi2_path -]
\begin{tabularx}{\textwidth}{@{}L L@{}}
\includegraphics[width=\linewidth]{[[ pulls_path ]]} &
\includegraphics[width=\linewidth]{[[ chi2_path ]]} \\
\end{tabularx}

\vspace{0.4em}

\begin{tabularx}{\textwidth}{@{}L L@{}}
[- else -]
\begin{tabularx}{\textwidth}{@{}L r@{}}
\includegraphics[width=0.64\linewidth]{[[ pulls_path ]]} &
[- endif -]
\begin{minipage}[t]{[[ mp_width ]]}
\small
\textbf{Key metrics}\par
\vspace{0.3em}
\begin{tabular}{@{}l r@{}}
\toprule
Metric & Value \\
\midrule
[- for key in ["global_chi2_per_bin", "blinded_chi2_per_bin", "global_chi2_pred_var"] -]
[- if metrics.get(key) is not none -]
[[ key | replace("_", "\\_") ]] & [[ "%.4g" | format(metrics.get(key)) ]] \\
[- endif -]
[- endfor -]
\bottomrule
\end{tabular}
[- if chi2_path -]
\end{minipage}
&
\begin{minipage}[t]{[[ mp_width ]]}
\small
[- else -]

\vspace{0.6em}
[- endif -]
\textbf{PPC (chi2)}\par
\vspace{0.2em}
\begin{tabular}{@{}l r@{}}
\toprule
Region & p-value \\
\midrule
[- set chi2_ppc = ppc.get("test_stats", {}).get("chi2", {}) -]
[- for region in ["all", "blinded", "unblinded"] -]
[- if chi2_ppc.get(region) is not none -]
[[ region ]] & [[ "%.3f" | format(chi2_ppc.get(region, {}).get("pvalue", 0.0)) ]] \\
[- endif -]
[- endfor -]
\bottomrule
\end{tabular}
\end{minipage}
\\
\end{tabularx}
